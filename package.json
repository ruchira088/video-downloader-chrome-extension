{
  "name": "video-downloader-chrome-extension",
  "version": "1.0.16",
  "description": "Chrome extension to schedule video downloads from websites",
  "author": "Ruchira (Richie) Jayasekara <me@ruchij.com>",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf .tsbuild && tsc && NODE_ENV=production webpack",
    "verify:build": "node scripts/verify-build.mjs",
    "dev": "tsc && (trap 'kill 0' EXIT; tsc --watch --preserveWatchOutput & webpack --watch)",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "prettier": "prettier -w .",
    "prettier:check": "prettier --check .",
    "deploy": "BUILD_TARGET='/Users/ruchira/Software/video-downloader-chrome-extension-build' npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "@types/luxon": "^3.7.4",
    "copy-webpack-plugin": "^14.0.0",
    "happy-dom": "^20.11.6",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "sass-loader": "^17.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "pretty-bytes": "^7.1.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "fsevents": false,
    "@parcel/watcher": false
  }
}
